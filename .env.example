NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:5173
TV_JOIN_BASE_URL=http://localhost:5173/join

DATABASE_URL=postgresql://quizparty:quizparty@127.0.0.1:5433/quizparty?schema=public
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=replace-me-with-a-long-secret
JWT_REFRESH_SECRET=replace-me-with-a-different-long-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Подпись player-token (анти-спуфинг playerId по сокету)
PLAYER_TOKEN_SECRET=replace-me-with-a-third-long-secret
PLAYER_TOKEN_EXPIRES_IN=1d
# При true сервер отвергает JOIN_LOBBY для известного playerId без токена.
# Включать после того, как ВСЕ клиенты выкатили версии, отправляющие токен.
PLAYER_TOKEN_STRICT=false
