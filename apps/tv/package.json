{
  "name": "@quizparty/tv",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "android:tv": "react-native run-android --variant debug",
    "build": "tsc -p tsconfig.json --noEmit",
    "ios": "react-native run-ios",
    "ios:tvos": "react-native run-ios --simulator \"Apple TV 4K (3rd generation)\"",
    "ios:tvos:1080p": "react-native run-ios --simulator \"Apple TV 4K (3rd generation) (at 1080p)\"",
    "lint": "../../node_modules/.bin/eslint src",
    "start": "react-native start --reset-cache",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@quizparty/shared": "workspace:*",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "qrcode": "^1.5.4",
    "react": "19.2.0",
    "react-native": "npm:react-native-tvos@0.83.0-0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.0.0",
    "react-native-svg": "^15.15.5",
    "react-native-video": "^6.16.1",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.83.0",
    "@react-native/eslint-config": "0.83.0",
    "@react-native/metro-config": "0.83.0",
    "@react-native/typescript-config": "0.83.0",
    "@types/jest": "^29.5.13",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
