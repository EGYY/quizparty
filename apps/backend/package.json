{
  "name": "@quizparty/backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -b tsconfig.json --force",
    "typecheck": "tsc -b tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "prisma:generate": "node ../../scripts/load-env.js prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "node ../../scripts/load-env.js prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:migrate:dev": "node ../../scripts/load-env.js prisma migrate dev --schema prisma/schema.prisma",
    "prisma:studio": "node ../../scripts/load-env.js prisma studio --schema prisma/schema.prisma",
    "prisma:seed": "node ../../scripts/load-env.js tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.1.19",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.19",
    "@prisma/client": "^6.0.0",
    "@quizparty/shared": "workspace:*",
    "bullmq": "^5.76.6",
    "helmet": "^8.1.0",
    "ioredis": "^5.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/node": "^22.0.0",
    "prisma": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.6"
  }
}
