{
  "name": "quizparty",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm --filter @quizparty/shared build && pnpm --filter '!@quizparty/shared' -r build",
    "dev:web": "pnpm --filter @quizparty/web dev",
    "dev:backend": "pnpm --filter @quizparty/backend start:dev",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps",
    "db:generate": "pnpm --filter @quizparty/backend prisma:generate",
    "db:migrate": "pnpm --filter @quizparty/backend prisma:migrate",
    "db:seed": "pnpm --filter @quizparty/backend prisma:seed",
    "db:studio": "pnpm --filter @quizparty/backend prisma:studio",
    "server:setup": "pnpm db:generate && pnpm db:migrate && pnpm db:seed",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.5.3",
    "typescript-eslint": "^8.0.0",
    "typescript": "^5.8.3"
  }
}
