# ─────────────────────────────────────────────────────────────
# QuizParty monorepo .gitignore
# Stack: pnpm workspaces · NestJS · Vite/React · React Native tvOS/Android
# ─────────────────────────────────────────────────────────────

# ══ Dependencies ══════════════════════════════════════════════
node_modules/
.pnp
.pnp.js

# ══ Build output ══════════════════════════════════════════════
dist/
build/
out/

# TypeScript incremental build info
*.tsbuildinfo

# ══ Environment & secrets ═════════════════════════════════════
.env
.env.*
!.env.example

# ══ Logs ══════════════════════════════════════════════════════
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ══ OS artefacts ══════════════════════════════════════════════
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ══ Editor & IDE ══════════════════════════════════════════════
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*~

# ══ Testing & Coverage ════════════════════════════════════════
coverage/
.nyc_output/
*.lcov

# ══ Cache & misc tooling ══════════════════════════════════════
.turbo/
.cache/
.eslintcache
.prettiercache

# ══ Backend — NestJS + Prisma ══════════════════════════════════

# User-uploaded files (served from disk, not versioned)
apps/backend/uploads/

# Prisma: keep migrations & schema, ignore generated client
apps/backend/prisma/generated/

# ══ TV app — React Native tvOS / Android ══════════════════════

# Metro bundler health-check temp files
apps/tv/.metro-health-check*

# Android build artefacts
apps/tv/android/.gradle/
apps/tv/android/app/build/
apps/tv/android/build/
apps/tv/android/local.properties
apps/tv/android/captures/
apps/tv/android/.idea/

# Android signing keys (keep debug.keystore for local builds)
*.keystore
!apps/tv/android/app/debug.keystore
*.jks

# iOS / tvOS build artefacts
apps/tv/ios/build/
apps/tv/ios/Pods/
apps/tv/ios/.xcode.env.local
apps/tv/ios/tv.xcworkspace/xcuserdata/
apps/tv/ios/tv.xcodeproj/xcuserdata/
apps/tv/ios/tv.xcodeproj/project.xcworkspace/xcuserdata/
DerivedData/

# Xcode source-control metadata (not needed in git)
*.xccheckout
*.xcscmblueprint

# Distribution artefacts
*.ipa
*.dSYM.zip
*.dSYM

# React Native bundle cache
apps/tv/.bundle/


